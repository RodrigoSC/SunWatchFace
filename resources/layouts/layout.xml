<layout id="WatchFace" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <bitmap id="SkySun" filename="sky-sun.png" visible="false"/>
    <bitmap id="SkyNight" filename="sky-night.png" visible="true"/>
    
    <label id="RiseBg" x="7%" y="35%"
        font="@Fonts.LedSmall" justification="Graphics.TEXT_JUSTIFY_LEFT" color="#373737" />
    <label
        id="Rise" x="7%" y="35%" font="@Fonts.LedSmall" justification="Graphics.TEXT_JUSTIFY_LEFT"
        color="Graphics.COLOR_LT_GRAY" />

    <label id="SetBg" x="93%" y="35%"
        font="@Fonts.LedSmall" justification="Graphics.TEXT_JUSTIFY_RIGHT" color="#373737" />
    <label
        id="Set" x="93%" y="35%" font="@Fonts.LedSmall" justification="Graphics.TEXT_JUSTIFY_RIGHT"
        color="Graphics.COLOR_LT_GRAY" />

    <label id="AltTimeBg" x="5%" y="center"
        font="@Fonts.Led" justification="Graphics.TEXT_JUSTIFY_LEFT" color="#373737" visible="false"/>
    <label
        id="AltTime" x="5%" y="center" font="@Fonts.Led" justification="Graphics.TEXT_JUSTIFY_LEFT"
        color="Graphics.COLOR_LT_GRAY" visible="false" />


    <label id="DateBg" x="95%" y="center"
        font="@Fonts.Led" justification="Graphics.TEXT_JUSTIFY_RIGHT" color="#373737" />
    <label
        id="Date" x="95%" y="center" font="@Fonts.Led" justification="Graphics.TEXT_JUSTIFY_RIGHT"
        color="Graphics.COLOR_LT_GRAY" />

    <label id="NotifsLabel" x="25%" y="65%"
        font="@Fonts.Eurostar" justification="Graphics.TEXT_JUSTIFY_CENTER"
        color="Graphics.COLOR_WHITE" text="NOTIFS" />
    <label id="NotifsBg" x="105" y="358"
        font="@Fonts.Led" justification="Graphics.TEXT_JUSTIFY_CENTER" color="#373737" />
    <label
        id="Notifs" x="105" y="358" font="@Fonts.Led" justification="Graphics.TEXT_JUSTIFY_CENTER"
        color="Graphics.COLOR_LT_GRAY" />

    <label id="StepsLabel" x="50%" y="65%"
        font="@Fonts.Eurostar" justification="Graphics.TEXT_JUSTIFY_CENTER"
        color="Graphics.COLOR_WHITE" text="STEPS" />
    <label id="StepsBg" x="227" y="358"
        font="@Fonts.Led" justification="Graphics.TEXT_JUSTIFY_CENTER" color="#373737" />
    <label
        id="Steps" x="227" y="358" font="@Fonts.Led"
        justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_LT_GRAY" />
    
    <label
        id="FloorsLabel" x="75%" y="65%" font="@Fonts.Eurostar"
        justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" text="FLOORS" />
    <label
        id="FloorsBg" x="349" y="75%" font="@Fonts.Led"
        justification="Graphics.TEXT_JUSTIFY_CENTER" color="#373737" />
    <label id="Floors"
        x="349" y="358" font="@Fonts.Led" justification="Graphics.TEXT_JUSTIFY_CENTER"
        color="Graphics.COLOR_LT_GRAY" />

    <label id="WeatherBg" x="50%" y="80%"
        font="@Fonts.Led" justification="Graphics.TEXT_JUSTIFY_CENTER" color="#373737" />
    <label
        id="Weather" x="50%" y="80%" font="@Fonts.Led"
        justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_LT_GRAY" />

</layout>